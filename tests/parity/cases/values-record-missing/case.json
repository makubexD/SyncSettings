{
  "description": "Import with a record stops with the contract's missing-value line naming the profile and machine, exit 1, and writes no file when <YOUR_NAME> has no value anywhere (Machines (program only), values on a machine).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": ""
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      },
      "output": "all",
      "stderr": true
    }
  ]
}
