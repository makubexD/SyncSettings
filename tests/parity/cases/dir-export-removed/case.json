{
  "description": "Export of a dir entry reports a repo file gone locally, then removes it: UNCHANGED then REMOVED (Directory entries).",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/dir",
        "localPath": "~/.config/parity/dir",
        "type": "dir",
        "platform": "common",
        "description": "Parity case folder"
      }
    ]
  },
  "commands": [{ "command": "export" }]
}
