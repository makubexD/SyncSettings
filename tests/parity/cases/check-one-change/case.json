{
  "description": "The import check lists one file it would overwrite, writes nothing and exits 3 (Import check).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/app.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/app.conf",
        "description": "Differs from the repo"
      },
      {
        "file": "parity/same.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/same.conf",
        "description": "Matches the repo"
      }
    ]
  },
  "commands": [
    {
      "command": "check"
    }
  ]
}
