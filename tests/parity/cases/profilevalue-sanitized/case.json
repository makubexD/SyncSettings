{
  "description": "export writes a base change as the entry's <YOUR_EMAIL> placeholder: the profile-value search runs after sanitize, so the hydrated value never trips it, and the file gets the placeholder with a sanitized note, exit 0 (Profile values (program only); Push preview (program only)).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings",
        "sanitize": [
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email for git commits"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "git": "committed",
  "commands": [
    {
      "command": "export",
      "output": "all"
    }
  ]
}
