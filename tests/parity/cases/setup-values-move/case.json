{
  "description": "setup copies .user-values.json once by the table: the email goes on the profile, the home path on the record, and the file itself is left unchanged (Machines (program only), values on a machine).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "values": {
    "<YOUR_EMAIL>": "work@example.com",
    "<HOME>": "/home/user"
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "commands": [
    {
      "command": "setup",
      "options": {
        "name": "wk1-laptop",
        "profile": "work-1",
        "claude": "claude",
        "mode": "push",
        "existing": "stop",
        "yes": true
      }
    }
  ]
}
