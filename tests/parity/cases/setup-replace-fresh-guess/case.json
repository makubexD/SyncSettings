{
  "description": "setup --replace asks each machine value before the summary with a fresh guess for this machine as the suggestion (git-user-name here, not the old machine's value) and falls back to the old value, source old machine, when no source answers; Enter takes each (mksync setup, Replace, Values before the summary, Summary).",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name",
            "suggest": [
              "git-user-name"
            ]
          },
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email"
          }
        ]
      }
    ]
  },
  "git": "committed",
  "env": {
    "SYNC_HOSTNAME": "wk1-new",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude",
    "MKSYNC_VISIBILITY": "private"
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "setup",
      "options": {
        "replace": "wk1-laptop",
        "existing": "stop"
      },
      "stdin": "\n\ny\n"
    }
  ]
}
