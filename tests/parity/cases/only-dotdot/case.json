{
  "description": "Export refuses a --only repo path with a .. segment, exit 1, before touching any file (Picking files, Path safety).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "options": {
        "only": [
          "dotfiles/common/../x"
        ]
      }
    }
  ]
}
