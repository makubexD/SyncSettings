{
  "description": "Import loads the repo file over the folder and keeps the machine's extra key: the entry is UPDATED with the old dump backed up (dconf entries, Import merges; Backups).",
  "os": [
    "linux"
  ],
  "stubs": [
    "dconf",
    "getent"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "dconf/app.ini",
        "module": "unsorted",
        "merge": "dconf",
        "os": [
          "linux"
        ],
        "dconfPath": "/test/app/",
        "description": "Parity case dconf entry"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
