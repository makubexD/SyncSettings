{
  "description": "Preview refuses --only before touching anything, exit 1 (Picking files).",
  "git": "committed",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "preview",
      "options": {
        "only": [
          "dotfiles/common/parity/a.conf"
        ]
      }
    }
  ]
}
