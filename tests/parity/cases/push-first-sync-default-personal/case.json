{
  "description": "Push with a personal record and no sync point suggests s for a json, a whole and a dir entry (the dir file [s/r/k] [s]); three Enters send all three, the PR question answered n opens no PR, exit 0 (Front door, push; No sync point, interactive).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig",
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      },
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file a"
      },
      {
        "file": "parity/folder",
        "module": "parity",
        "merge": "dir",
        "localPath": "~/.config/parity/folder",
        "description": "Parity case folder"
      }
    ]
  },
  "commands": [
    {
      "command": "push",
      "stdin": "\n\n\n\n\n\nn\n"
    }
  ]
}
