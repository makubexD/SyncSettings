{
  "description": "Export stops before touching a file when a localPath is absolute (Path safety).",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/ok.conf",
        "localPath": "~/.config/parity/ok.conf",
        "platform": "common",
        "description": "Parity case file"
      },
      {
        "repoPath": "dotfiles/common/parity/bad.conf",
        "localPath": "/tmp/parity-x.conf",
        "platform": "common",
        "description": "Parity case entry with an absolute localPath"
      }
    ]
  },
  "commands": [{ "command": "export" }]
}
