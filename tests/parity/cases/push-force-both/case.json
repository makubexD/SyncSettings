{
  "description": "Push --force sends the BOTH file as this machine's version and leaves the IN file alone, committing with --partial so the sync point does not move, exit 0 (Front door, push; Sync point).",
  "os": ["linux"],
  "git": "remote",
  "syncPoint": true,
  "stubs": ["gh"],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "First parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Second parity case file"
      },
      {
        "file": "parity/c.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/c.conf",
        "description": "Third parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "options": {
        "paths": [
          "dotfiles/common/parity/a.conf"
        ],
        "yes": true
      }
    },
    {
      "command": "push",
      "options": {
        "force": true,
        "yes": true
      }
    },
    {
      "command": "front-diff"
    }
  ]
}
