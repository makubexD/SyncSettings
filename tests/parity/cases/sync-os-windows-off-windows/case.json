{
  "description": "Import stops before touching a file when SYNC_OS names Windows off Windows: exit 1, no status line (Which system).",
  "os": [
    "linux",
    "macos"
  ],
  "env": {
    "SYNC_OS": "windows"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "check"
    }
  ]
}
