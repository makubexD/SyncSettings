{
  "description": "A new file under packages/ is a sync path, so commit scans and commits it and opens the PR, exit 0 (Checks before pushing).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "commands": [
    {
      "command": "commit"
    }
  ]
}
