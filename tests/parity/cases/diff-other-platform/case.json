{
  "description": "Diff leaves out an entry for another OS even when origin changed it, exit 0 (Diff, Entry selection). Ported from diff-other-platform.",
  "os": [
    "linux",
    "macos"
  ],
  "git": "remote",
  "syncPoint": true,
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "win.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/win.conf",
        "os": [
          "windows"
        ],
        "description": "Windows fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "diff"
    }
  ]
}
