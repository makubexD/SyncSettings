{
  "description": "Diff labels nothing when origin put this machine's new item in the Linux layer while the export would put it in the base layer: both sides build the same file, exit 0 (Diff, Layers).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "syncPoint": true,
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "commands": [
    {
      "command": "diff"
    }
  ]
}
