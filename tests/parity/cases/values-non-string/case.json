{
  "description": "Import hydrates a non-string value: a JSON number is read with jq tostring, used as text and saved back as a string (Sanitize and hydrate, Values).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<PORT>",
            "prompt": "Port"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<PORT>": 8080
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
