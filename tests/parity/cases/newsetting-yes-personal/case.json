{
  "description": "export --yes on the personal profile sends a new array item to the base suggested there, stores the path in the profile's destinations as base and writes it into dotfiles/common, exit 0 (New settings (program only), Choice and suggestion, The answer is stored).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "git": "committed",
  "commands": [
    {
      "command": "export",
      "options": {
        "yes": true
      },
      "output": "all"
    }
  ]
}
