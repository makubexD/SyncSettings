{
  "description": "Pull --force skips the diff and overwrites the file this machine changed, keeping a .bak, exit 0 (Front door, pull guard, --force).",
  "os": [
    "linux",
    "windows"
  ],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "options": {
        "yes": true,
        "force": true
      }
    }
  ],
  "syncPoint": true
}
