{
  "description": "Doctor says OK for git login when no helper names the owner but gh's own git-credential helper is first and the active token is the owner's (Front door, git login).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "doctor"
    }
  ],
  "stubs": [
    "gh"
  ],
  "originUrl": "https://github.com/owner1/SyncSettings.git",
  "ghAccounts": [
    "owner1"
  ]
}
