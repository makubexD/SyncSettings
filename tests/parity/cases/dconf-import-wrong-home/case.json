{
  "description": "Import with a HOME that is not the getent login home skips the dconf entry and leaves dconf alone: SKIPPED HOME is not the login home (Import; dconf entries).",
  "os": ["linux"],
  "stubs": ["dconf", "getent"],
  "env": { "HOME": "/nonexistent" },
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/linux/dconf/app.ini",
        "type": "dconf",
        "platform": "linux",
        "path": "/test/app/",
        "description": "Parity case dconf entry"
      }
    ]
  },
  "commands": [{ "command": "import", "options": { "force": true } }]
}
