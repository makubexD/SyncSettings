{
  "description": "Import with a HOME that is not the getent login home skips the dconf entry and leaves dconf alone: SKIPPED HOME is not the login home (Import; dconf entries).",
  "os": [
    "linux"
  ],
  "stubs": [
    "dconf",
    "getent"
  ],
  "env": {
    "HOME": "/nonexistent"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "dconf/app.ini",
        "module": "unsorted",
        "merge": "dconf",
        "os": [
          "linux"
        ],
        "dconfPath": "/test/app/",
        "description": "Parity case dconf entry"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
