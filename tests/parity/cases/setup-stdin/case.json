{
  "description": "setup reads the four answers from stdin (a new profile name, 2, 1, 1) and writes the same record and profile as setup-flags; piped prompts have no trailing newline, so each question runs into the next output (Machines (program only), mksync setup).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "commands": [
    {
      "command": "setup",
      "stdin": "work-1\n2\n1\n1\n"
    }
  ]
}
