{
  "description": "Pull with a sync point asks its value questions before its check and guard: the answer fills the placeholder, so the guard finds the file IN and passes, the apply question takes the repo's theme with a .bak, exit 0, with the answer saved to .user-values.json (Front door, pull; Pull asks).",
  "os": ["linux"],
  "git": "remote",
  "syncPoint": true,
  "stubs": ["gh"],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": ["*.bak"],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Sanitized parity settings",
        "sanitize": [
          {
            "placeholder": "<YOUR_GH_OWNER>",
            "prompt": "GitHub owner"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "stdin": "owner\ny\n",
      "stderr": true
    }
  ]
}
