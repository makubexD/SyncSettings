{
  "description": "Export stops before touching a file when a dconfPath has no leading or trailing slash (Path safety).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/ok.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/ok.conf",
        "description": "Parity case file"
      },
      {
        "file": "parity/test.ini",
        "module": "unsorted",
        "merge": "dconf",
        "dconfPath": "org/parity/",
        "os": [
          "linux"
        ],
        "description": "Parity case dconf entry with a path that has no leading slash"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
