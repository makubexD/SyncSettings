{
  "description": "Diff with --only labels and counts only the picked path (Diff).",
  "git": "remote",
  "syncPoint": true,
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "First parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Second parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "diff",
      "options": {
        "only": [
          "dotfiles/common/parity/a.conf"
        ]
      }
    }
  ]
}
