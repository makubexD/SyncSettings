{
  "description": "Export of a common sanitized entry writes the placeholders and marks the new repo file ADDED with the sanitized note (Sanitize and hydrate; Statuses, Export).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "shared.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/shared.conf",
        "sanitize": [
          {
            "placeholder": "<NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Shared sanitized fixture"
      }
    ]
  },
  "values": {
    "<NAME>": "Parity User"
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
