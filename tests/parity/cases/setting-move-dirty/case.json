{
  "description": "setting move that would write a dotfiles file already differing from the clone's HEAD stops before anything is written, exit 1 (mksync setting move, Never a write to master).",
  "os": ["linux"],
  "git": "committed",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "vscode": {
        "description": "VS Code"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "vscode/settings.json",
        "module": "vscode",
        "merge": "json",
        "localPath": "~/.config/Code/User/settings.json",
        "description": "VS Code settings"
      },
      {
        "file": "git/.gitconfig.local",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.gitconfig.local",
        "description": "Local git settings"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": ""
  },
  "commands": [
    {
      "command": "setting-move",
      "options": {
        "target": "vscode/settings.json",
        "key": "editor.fontSize",
        "to": "base",
        "yes": true
      },
      "stderr": true
    }
  ]
}
