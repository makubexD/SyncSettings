{
  "description": "Export with --only modifies the picked file of a directory entry and keeps a repo file gone locally when it isn't picked (Picking files, Directory entries). Ported from export-only-dir-removed, Pester export-only-dir-removed.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "os": [
          "linux"
        ],
        "description": "Plain text fixture"
      },
      {
        "file": "dir",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/fixture/dir",
        "description": "Directory fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "options": {
        "only": [
          "dotfiles/common/dir/a/b.txt"
        ]
      }
    }
  ]
}
