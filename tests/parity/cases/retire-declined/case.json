{
  "description": "machine retire without --yes asks the contract's question; end of input on stdin retires nothing, prints Nothing retired. and exits 1, leaving the record as it was (Machines (program only), retire).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "commands": [
    {
      "command": "machine-retire",
      "options": {
        "target": "wk1-laptop"
      },
      "stdin": ""
    }
  ]
}
