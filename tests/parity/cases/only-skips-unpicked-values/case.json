{
  "description": "Import with --only updates the picked file without asking for an unpicked entry's missing value, and the same run without --only stops with exit 1 and writes nothing (Picking files, Values). Ported from only-skips-unpicked-values.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "description": "Plain text fixture"
      },
      {
        "file": "san.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/san.conf",
        "sanitize": [
          {
            "placeholder": "<MISSING>",
            "prompt": "Missing value"
          }
        ],
        "description": "Sanitized fixture"
      }
    ]
  },
  "values": {},
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true,
        "only": [
          "dotfiles/common/plain.txt"
        ]
      }
    },
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
