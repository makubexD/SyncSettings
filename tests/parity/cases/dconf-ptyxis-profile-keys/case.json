{
  "description": "The Ptyxis keys allowlist keeps a profile's label and palette and drops every key nobody named (dconf entries, keys).",
  "os": [
    "linux"
  ],
  "stubs": [
    "dconf",
    "getent"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "dconf/app.ini",
        "module": "unsorted",
        "merge": "dconf",
        "os": [
          "linux"
        ],
        "dconfPath": "/org/gnome/Ptyxis/",
        "keys": [
          "audible-bell",
          "cursor-blink-mode",
          "cursor-shape",
          "default-columns",
          "default-profile-uuid",
          "default-rows",
          "disable-padding",
          "enable-a11y",
          "enable-zoom-scroll-ctrl",
          "font-name",
          "ignore-osc-title",
          "inhibit-logout",
          "interface-style",
          "new-tab-position",
          "profile-uuids",
          "prompt-on-close",
          "restore-session",
          "restore-window-size",
          "scrollbar-policy",
          "tab-middle-click",
          "text-blink-mode",
          "toast-on-copy-clipboard",
          "use-system-font",
          "visual-bell",
          "visual-process-leader",
          "word-char-exceptions",
          "Profiles/*/backspace-binding",
          "Profiles/*/bold-is-bright",
          "Profiles/*/cell-height-scale",
          "Profiles/*/cell-width-scale",
          "Profiles/*/cjk-ambiguous-width",
          "Profiles/*/delete-binding",
          "Profiles/*/exit-action",
          "Profiles/*/label",
          "Profiles/*/limit-scrollback",
          "Profiles/*/login-shell",
          "Profiles/*/opacity",
          "Profiles/*/palette",
          "Profiles/*/preserve-directory",
          "Profiles/*/scroll-on-keystroke",
          "Profiles/*/scroll-on-output",
          "Profiles/*/scrollback-lines",
          "Profiles/*/use-proxy"
        ],
        "description": "Parity case Ptyxis entry with the real key allowlist"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
