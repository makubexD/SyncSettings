{
  "description": "Pull with a sync point and origin one commit ahead fast-forwards, applies the repo's file with a .bak, and records the sync point, exit 0 (Front door, pull row).",
  "os": ["linux", "windows"],
  "git": "remote",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/a.conf",
        "localPath": "~/.config/parity/a.conf",
        "platform": "common",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [{ "command": "pull", "options": { "yes": true } }],
  "syncPoint": true
}
