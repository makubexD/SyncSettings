{
  "description": "A v2 config named sync-config.json is read as v2, so an installed v0.9.0 keeps importing after the config is renamed (decision 8 of docs/plan-single-engine-9-cutover.md; Config v2).",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "os": ["linux", "macos", "windows"],
        "description": "Parity case file"
      }
    ]
  },
  "configName": "sync-config.json",
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
