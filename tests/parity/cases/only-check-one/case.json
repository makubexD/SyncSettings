{
  "description": "Check with --only lists only the picked changed file and exits 3 (Picking files, Import check). Ported from import-only-check, Pester import-only-check.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "description": "Plain text fixture"
      },
      {
        "file": "tool.sh",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/tool.sh",
        "description": "Shell script fixture"
      },
      {
        "file": "dir",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/fixture/dir",
        "description": "Directory fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "check",
      "options": {
        "only": [
          "dotfiles/common/plain.txt"
        ]
      }
    }
  ]
}
