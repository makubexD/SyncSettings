{
  "description": "Export of a dir entry skips every credential the shipped excludePatterns name and copies only the ordinary file (Exclude patterns; Statuses, Export; Directory entries).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.pem",
      "*.key",
      "*.pfx",
      "*.p12",
      "*.bak",
      "id_rsa*",
      "id_ed25519*",
      "id_ecdsa*",
      "*.credential*",
      "credentials",
      "credentials.json",
      ".env",
      ".env.*",
      "*.secret*",
      "*.token*",
      ".git-credentials",
      ".netrc",
      ".npmrc",
      ".pgpass",
      "hosts.yml",
      "auth.json",
      "secrets.yaml",
      "token",
      "*.env",
      "id_dsa*"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "creds",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/fixture/creds",
        "description": "Excluded credentials fixture"
      }
    ]
  },
  "env": {
    "LC_ALL": "C"
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
