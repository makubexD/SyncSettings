{
  "description": "setup --yes with no --profile on Linux with no domain prints the guess line and still stops with ERROR: missing --profile and exit 2, because --yes never takes a personal guess; nothing is written (Machines (program only), mksync setup, --yes). This is what install.sh --yes runs.",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "setup",
      "options": {
        "name": "wk1-laptop",
        "yes": true
      },
      "stderr": true
    }
  ]
}
