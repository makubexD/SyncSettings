{
  "description": "An import puts the value back and the import check that follows finds the hydrated file unchanged, exit 0 (Import check). Ported from import-check-sanitized.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "named.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/named.conf",
        "sanitize": [
          {
            "placeholder": "<NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Sanitized fixture"
      }
    ]
  },
  "values": {
    "<NAME>": "Someone"
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    },
    {
      "command": "check"
    }
  ]
}
