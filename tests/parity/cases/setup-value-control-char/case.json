{
  "description": "setup refuses a --value holding a newline before anything runs, exit 2: a value is one line, as a typed answer is (mksync setup, --value).",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          },
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "setup",
      "options": {
        "profile": "personal",
        "name": "wk1-laptop",
        "yes": true,
        "value": [
          "YOUR_NAME=Jane\nDoe"
        ]
      },
      "stderr": true
    }
  ]
}
