{
  "description": "A cached value appears in its doubled-backslash form, so commit still stops on it, exit 1, and never calls gh (Checks before pushing).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      },
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "os": [
          "linux"
        ],
        "sanitize": [
          {
            "placeholder": "<WINPATH>",
            "prompt": "Tools path",
            "escapeBackslashes": true
          }
        ],
        "description": "Sanitized fixture"
      }
    ]
  },
  "values": {
    "<WINPATH>": "C:\\Tools\\gh.exe"
  },
  "commands": [
    {
      "command": "commit",
      "output": "all",
      "stderr": true
    }
  ]
}
