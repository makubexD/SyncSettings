{
  "description": "setup reads its four answers from stdin, then the import it runs asks for <YOUR_NAME>, which nothing else fills, from the same input; the answer is hydrated and saved on the profile (Sanitize and hydrate; docs/plan-single-engine-9-values.md).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "stubs": ["gh"],
  "commands": [
    {
      "command": "setup",
      "stdin": "work-1\n2\n1\n1\nJane Doe\n"
    }
  ]
}
