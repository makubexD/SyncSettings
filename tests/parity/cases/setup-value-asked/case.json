{
  "description": "setup reads its four answers from stdin, then asks before the summary for <YOUR_NAME>, which its import would ask since nothing else fills it, in the import's words; the typed answer shows in Values and Same as, is saved on the profile and hydrated, and nothing is asked after the confirm (mksync setup, Values before the summary; Sanitize and hydrate; docs/archive/plan-single-engine-9-values.md).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "stubs": ["gh"],
  "commands": [
    {
      "command": "setup",
      "stdin": "work-1\n\n2\n1\n1\nJane Doe\n\n"
    }
  ]
}
