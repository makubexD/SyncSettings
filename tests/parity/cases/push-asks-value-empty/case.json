{
  "description": "Export asks for a value nothing fills; an empty answer stops at once with the missing-value line naming push and pull, exit 1, and writes nothing (Sanitize and hydrate, Push asks; Missing value).",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "stdin": "\n"
    }
  ]
}
