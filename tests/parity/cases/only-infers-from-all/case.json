{
  "description": "Import with --only infers values from every entry, not just the picked one, and caches them (Picking files, Inference on import, Values).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<USER>",
            "prompt": "User name"
          }
        ],
        "description": "First parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "sanitize": [
          {
            "placeholder": "<USER>",
            "prompt": "User name"
          }
        ],
        "description": "Second parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true,
        "only": [
          "dotfiles/common/parity/a.conf"
        ]
      }
    }
  ]
}
