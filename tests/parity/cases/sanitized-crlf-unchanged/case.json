{
  "description": "Export treats a sanitized file that differs only in CRLF line endings and trailing blank lines as equal to the repo: UNCHANGED (Compare).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<YOUR_NAME>": "Parity User"
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
