{
  "description": "Doctor prints no git login line when the owner has no gh token (no owner account signed in) (Front door, git login).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "doctor"
    }
  ],
  "originUrl": "https://github.com/owner1/SyncSettings.git",
  "stubs": [
    "gh"
  ]
}
