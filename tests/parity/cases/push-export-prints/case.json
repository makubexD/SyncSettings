{
  "description": "export --yes prints the grouped block before it writes, then the export's status lines and summary, and writes each changed layer, exit 0 (Push preview (program only), Where the push side runs; New settings (program only), --yes).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "git": "committed",
  "commands": [
    {
      "command": "export",
      "options": {
        "yes": true
      },
      "output": "all"
    }
  ]
}
