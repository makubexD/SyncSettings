{
  "description": "import --check groups what an import would change by the layer each new value comes from, with the header Changes from the repo:, after the status lines and before the summary, exit 3 (Import check; Push preview (program only); Groups).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "git": "committed",
  "commands": [
    {
      "command": "check",
      "output": "all"
    }
  ]
}
