{
  "description": "export with a new array item and a differing profile value and stdin already ended takes the suggestion (3, the profile) for the item and the repo's value for the email, exit 0 without hanging (New settings (program only), Asking; The first backup).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "private"
  },
  "git": "committed",
  "commands": [
    {
      "command": "export",
      "stdin": "",
      "output": "all"
    }
  ]
}
