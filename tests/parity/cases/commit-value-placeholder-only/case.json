{
  "description": "A sync file holding only the placeholder passes the cached-value check, so commit opens the PR, exit 0 (Checks before pushing).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      },
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "os": [
          "linux"
        ],
        "sanitize": [
          {
            "placeholder": "<NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Sanitized fixture"
      }
    ]
  },
  "values": {
    "<NAME>": "Fixture User"
  },
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "commands": [
    {
      "command": "commit"
    }
  ]
}
