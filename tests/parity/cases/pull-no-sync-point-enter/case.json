{
  "description": "With no sync point the question is [y/N] after a warning: an empty answer is no, nothing is applied, exit 0 (Front door, pull guard without a sync point).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/b.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "stdin": "\n"
    }
  ]
}
