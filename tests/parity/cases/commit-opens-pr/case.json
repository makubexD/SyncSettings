{
  "description": "Export then commit opens a PR: both exit 0 and gh pr create runs (Flow).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    },
    {
      "command": "commit"
    }
  ]
}
