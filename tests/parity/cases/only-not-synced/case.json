{
  "description": "Import refuses a --only path no entry owns, exit 1, before touching any file (Picking files).",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/a.conf",
        "localPath": "~/.config/parity/a.conf",
        "platform": "common",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": { "force": true, "only": ["dotfiles/common/parity/none"] }
    }
  ]
}
