{
  "description": "Diff stops with exit 1 and the file's ERROR line when the local JSON can't be read, instead of saying both sides agree (Diff).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "syncPoint": true,
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "commands": [
    {
      "command": "diff"
    }
  ]
}
