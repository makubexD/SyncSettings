{
  "description": "The import check treats a local sanitized file whose text differs from the hydrated repo as changed and lists it, exit 3 (Import check). Ported from import-check-sanitized.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "named.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/named.conf",
        "sanitize": [
          {
            "placeholder": "<NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Sanitized fixture"
      }
    ]
  },
  "values": {
    "<NAME>": "Someone"
  },
  "commands": [
    {
      "command": "check"
    }
  ]
}
