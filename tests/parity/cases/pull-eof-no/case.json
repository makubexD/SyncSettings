{
  "description": "End of input at pull's question is no, even though an empty answer is yes: nobody is there to answer, so nothing is applied, exit 0 (Front door, pull).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/b.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "stdin": ""
    }
  ],
  "syncPoint": true
}
