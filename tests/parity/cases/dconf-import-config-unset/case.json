{
  "description": "With XDG_CONFIG_HOME unset the config folder is ~/.config, so an empty dconf folder is CREATED: dconf entries, Import.",
  "os": ["linux"],
  "stubs": ["dconf", "getent"],
  "env": { "XDG_CONFIG_HOME": null },
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/linux/dconf/app.ini",
        "type": "dconf",
        "platform": "linux",
        "path": "/test/app/",
        "description": "Parity case dconf entry"
      }
    ]
  },
  "commands": [{ "command": "import", "options": { "force": true } }]
}
