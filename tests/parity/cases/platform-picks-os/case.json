{
  "description": "Export picks only the entries for the running OS, plus common (Entry selection).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/lin.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/lin.conf",
        "os": [
          "linux"
        ],
        "description": "Linux parity file"
      },
      {
        "file": "parity/win.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/win.conf",
        "os": [
          "windows"
        ],
        "description": "Windows parity file"
      },
      {
        "file": "parity/com.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/com.conf",
        "description": "Shared parity file"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ],
  "differences": [
    "Entry selection"
  ]
}
