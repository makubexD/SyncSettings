{
  "description": "mksync --help, -h and --version --help print the top-level help on stdout, exit 0; mksync alone prints and exits as mksync status (The program, Help).",
  "os": ["linux"],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": ["*.bak"],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "env": {
    "SYNC_OS_RELEASE": "os-release"
  },
  "commands": [
    {
      "command": "args",
      "argv": ["--help"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["-h"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["--version", "--help"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["status"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": [],
      "stderr": true
    }
  ]
}
