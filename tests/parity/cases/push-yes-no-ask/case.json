{
  "description": "Export with --yes asks for no value: a placeholder nothing fills stops with the missing-value line, exit 1, and writes nothing (Sanitize and hydrate, Push asks). A suggestion is never run or taken under --yes, so gh is not called.",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name",
            "suggest": "gh-login"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "options": {
        "yes": true
      },
      "stdin": "Ana Lopez\n"
    }
  ],
  "stubs": [
    "gh"
  ]
}
