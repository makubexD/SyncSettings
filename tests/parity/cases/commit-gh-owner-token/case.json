{
  "description": "With the repo owner signed in beside another active account, commit asks gh for the owner's token once and runs gh pr create with GH_TOKEN set to it (gh account).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    },
    {
      "command": "commit"
    }
  ],
  "originUrl": "https://github.com/owner1/SyncSettings.git",
  "ghAccounts": [
    "work1",
    "owner1"
  ]
}
