{
  "description": "Pull never takes a suggestion at end of input: the value stays missing and the run stops (Sanitize and hydrate, Suggested answers). Linux only: the Windows runner pipes an empty stdin as one empty line, which is Enter.",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_GH_USERNAME>",
            "prompt": "GitHub username",
            "suggest": "gh-login"
          }
        ]
      }
    ]
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
