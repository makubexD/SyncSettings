{
  "description": "Import never scans a value it put in: a value that holds another placeholder is written as it is (Sanitize and hydrate).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<A>",
            "prompt": "Value that looks like a placeholder"
          },
          {
            "placeholder": "<B>",
            "prompt": "Plain value"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<A>": "x<B>y",
    "<B>": "Z"
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
