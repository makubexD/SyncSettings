{
  "description": "An unknown command names itself and points at --help, --help included; an unknown first option stays Unknown option, each exit 2 (The program).",
  "os": ["linux"],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": ["*.bak"],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "args",
      "argv": ["bogus"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["bogus", "--help"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["-x"],
      "stderr": true
    }
  ]
}
