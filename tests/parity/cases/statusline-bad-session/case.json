{
  "description": "A session_id that doesn't match ^[A-Za-z0-9_-]+$ writes no context-window file [Statusline (program only)].",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "entries": []
  },
  "env": {
    "SYNC_NOW": "09:30",
    "SYNC_LOAD": "0.42",
    "SYNC_MEM": "3.1G/15.5G",
    "SYNC_GIT": "none",
    "CONTEXT_CLEAR_AT": null
  },
  "commands": [
    {
      "command": "statusline",
      "stdin": "{\"session_id\":\"../x\",\"context_window\":{\"context_window_size\":200000}}\n"
    }
  ]
}
