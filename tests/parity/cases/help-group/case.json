{
  "description": "A group's --help or -h lists its verbs, exit 0 (The program, Help).",
  "os": ["linux"],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": ["*.bak"],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "args",
      "argv": ["setting", "--help"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["machine", "--help"],
      "stderr": true
    },
    {
      "command": "args",
      "argv": ["profile", "-h"],
      "stderr": true
    }
  ]
}
