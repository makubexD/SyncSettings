{
  "description": "Export skips a local file that matches an exclude pattern: SKIPPED (Exclude patterns).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak",
      "*.log"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/x.log",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/x.log",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
