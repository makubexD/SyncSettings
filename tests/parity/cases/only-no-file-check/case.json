{
  "description": "Check with --only matching no file warns and leaves both trees unchanged, exit 0 (Picking files). Ported from only-no-file-check, Pester only-no-file-check.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "os": [
          "linux"
        ],
        "description": "Plain text fixture"
      },
      {
        "file": "dir",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/fixture/dir",
        "description": "Directory fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "check",
      "options": {
        "only": [
          "~/.config/fixture/dir/missing.txt"
        ]
      }
    }
  ]
}
