{
  "description": "A sanitize rule whose suggest is not a source name or a non-empty list of distinct names stops check with exit 1 when the config is read (Path safety; Configuration, suggest).",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity fixture"
      }
    },
    "entries": [
      {
        "file": "parity/git.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/git.conf",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name",
            "suggest": 1
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "check",
      "stderr": true
    }
  ]
}
