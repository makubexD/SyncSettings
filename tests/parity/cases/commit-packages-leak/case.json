{
  "description": "A new file under packages/ holds a home path, so the leak scan stops commit, exit 1, and it never calls gh (Checks before pushing).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "commit",
      "output": "all",
      "stderr": true
    }
  ]
}
