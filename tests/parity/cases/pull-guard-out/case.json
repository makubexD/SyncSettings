{
  "description": "Pull with a sync point stops on a file this machine changed, printing the OUT line before the ERROR pair, exit 1 and writes nothing (Front door, pull guard).",
  "os": ["linux", "windows"],
  "git": "remote",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/a.conf",
        "localPath": "~/.config/parity/a.conf",
        "platform": "common",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [{ "command": "pull", "options": { "yes": true } }],
  "syncPoint": true
}
