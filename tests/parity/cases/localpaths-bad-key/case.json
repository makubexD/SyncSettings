{
  "description": "Export stops before touching a file when a localPaths key is not a known system (Path safety).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/ok.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/ok.conf",
        "description": "Parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "localPaths": {
          "freebsd": "~/.config/parity/b.conf"
        },
        "description": "Parity case entry with an unknown localPaths key"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
