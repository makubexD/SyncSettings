{
  "description": "Push with a work record and no sync point answers p for a whole entry: the local file becomes the profile layer's copy, the base keeps its own, the local file is unchanged, no PR opens and the sync point is recorded, exit 0 (Front door, push; No sync point, interactive; Sync point).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig",
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file a"
      }
    ]
  },
  "commands": [
    {
      "command": "push",
      "stdin": "p\n"
    }
  ]
}
