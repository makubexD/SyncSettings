{
  "description": "Ubuntu setup asks the bootstrap question, runs bootstrap/linux.sh when the answer is y, and does not run it on an empty answer; exit 0 both (Front door, setup; ported from sync_setup_offers_bootstrap).",
  "os": ["linux"],
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/plain.txt",
        "localPath": "~/.config/parity/plain.txt",
        "platform": "common",
        "description": "Matches the repo"
      }
    ]
  },
  "env": {
    "SYNC_OS_RELEASE": "../home/os-release"
  },
  "stubs": ["bootstrap", "gh"],
  "commands": [
    {
      "command": "setup",
      "options": { "yes": true },
      "stdin": "y\n"
    },
    {
      "command": "setup",
      "options": { "yes": true }
    }
  ]
}
