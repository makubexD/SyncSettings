{
  "description": "On Ubuntu with an executable bootstrap/linux.sh, the v2 setup asks the bootstrap question after question 4 and before the summary; an empty answer skips the script and setup goes on with the first pull, exit 0 (Machines (program only), mksync setup, bootstrap). The y answer is setup-bootstrap-question.",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude",
    "SYNC_OS_RELEASE": "../home/os-release"
  },
  "stubs": [
    "bootstrap",
    "gh"
  ],
  "commands": [
    {
      "command": "setup",
      "options": {
        "profile": "work-1",
        "yes": true
      },
      "stdin": "\n"
    }
  ]
}
