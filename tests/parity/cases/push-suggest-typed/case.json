{
  "description": "Push shows a rule's suggestion as the question's default, and a typed answer replaces it (Sanitize and hydrate, Suggested defaults).",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_GH_USERNAME>",
            "prompt": "GitHub username",
            "suggest": "gh-login"
          }
        ]
      }
    ]
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "export",
      "stdin": "other-user\n"
    }
  ]
}
