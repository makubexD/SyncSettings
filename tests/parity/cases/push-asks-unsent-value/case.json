{
  "description": "Push asks for a placeholder of an entry it doesn't send (no local file) and saves the answer, since a later push or pull needs it (Sanitize and hydrate, Push asks).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Sanitized parity file, no local copy",
        "sanitize": [
          {
            "placeholder": "<YOUR_GH_ORG>",
            "prompt": "GitHub organization"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "stdin": "Parity Org\n"
    }
  ]
}
