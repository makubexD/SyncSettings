{
  "description": "Import with a record asks for a placeholder that nothing else fills, hydrates the piped answer into the new local file and saves it on the profile, leaving the machine record unchanged (Machines (program only), values on a machine; docs/archive/plan-single-engine-9-values.md decision 4).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": ""
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      },
      "stdin": "Jane Doe\n"
    }
  ]
}
