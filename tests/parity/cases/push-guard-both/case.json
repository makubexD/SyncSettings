{
  "description": "Push with a sync point stops on a file changed on both sides: the BOTH line, its conflict block and the two ERROR lines on stderr, exit 1, nothing exported or committed (Front door, push; Conflict block).",
  "os": ["linux"],
  "git": "remote",
  "syncPoint": true,
  "stubs": ["gh"],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "First parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Second parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "options": {
        "paths": [
          "dotfiles/common/parity/a.conf"
        ],
        "yes": true
      }
    },
    {
      "command": "push",
      "options": {
        "yes": true
      },
      "stderr": true
    }
  ]
}
