{
  "description": "setup --profile naming a retired profile stops with the contract's retired error and exit 1, after the scan and the profile list and before anything is written (Machines (program only), mksync setup).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "commands": [
    {
      "command": "setup",
      "options": {
        "name": "wk1-laptop",
        "profile": "work-1",
        "claude": "claude",
        "mode": "push",
        "existing": "stop",
        "yes": true
      },
      "stderr": true
    }
  ]
}
