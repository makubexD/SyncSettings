{
  "description": "Pull --force with picked paths and no sync point fast-forwards and applies only the picked file, records no sync point, and leaves the unpicked file as it was, exit 0 (Front door, pull row; Sync point).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "os": [
          "linux"
        ],
        "description": "First parity case file"
      },
      {
        "file": "no-trailing.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/no-trailing.txt",
        "os": [
          "linux"
        ],
        "description": "Second parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "options": {
        "yes": true,
        "force": true,
        "paths": [
          "dotfiles/linux/plain.txt"
        ]
      }
    }
  ]
}
