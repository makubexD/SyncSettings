{
  "description": "Import with two --only picks updates both picked files with their backups and leaves the third entry untouched (Picking files, Backups). Ported from Pester import-only-split.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "description": "Plain text fixture"
      },
      {
        "file": "tool.sh",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/tool.sh",
        "description": "Shell script fixture"
      },
      {
        "file": "other.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/other.txt",
        "description": "Unpicked fixture"
      },
      {
        "file": "dir",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/fixture/dir",
        "description": "Directory fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true,
        "only": [
          "dotfiles/common/plain.txt",
          "dotfiles/common/tool.sh"
        ]
      }
    }
  ]
}
