{
  "description": "Import of a dir entry reports a local file the repo doesn't have and keeps it: UNCHANGED then EXTRA (Directory entries).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/dir",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/parity/dir",
        "description": "Parity case folder"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
