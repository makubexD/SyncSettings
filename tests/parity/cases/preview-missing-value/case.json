{
  "description": "A preview never asks: a file whose placeholder has no value is SKIPPED with the placeholder it needs, nothing is written, and the preview exits 1 (Export preview).",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "preview",
      "stdin": "Ana Lopez\n"
    }
  ],
  "git": "committed"
}
