{
  "description": "export --preview with a record infers the values it needs, so it prints the change without a missing-value stop, shows no real value and writes no file (Sanitize and hydrate, Inference; Export preview).",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/git.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/git.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email for git commits"
          },
          {
            "placeholder": "<HOME>",
            "prompt": "Home folder"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "git": "committed",
  "commands": [
    {
      "command": "preview"
    }
  ]
}
