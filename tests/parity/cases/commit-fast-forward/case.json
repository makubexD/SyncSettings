{
  "description": "A commit that fast-forwards first opens the PR and records no sync point: nothing compared the commits it brought with this machine (Sync point).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "commands": [
    {
      "command": "export"
    },
    {
      "command": "commit"
    }
  ],
  "syncPoint": true
}
