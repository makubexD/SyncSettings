{
  "description": "Export replaces the values with placeholders, and import of the same file then finds nothing to change (Sanitize and hydrate).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/git.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/git.conf",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          },
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<YOUR_NAME>": "Parity User",
    "<YOUR_EMAIL>": "parity@example.com"
  },
  "commands": [
    {
      "command": "export"
    },
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
