{
  "description": "Export refuses a --only path under a file entry's linked folder, exit 1, before touching any file (Picking files). Ported from only-repo-linked.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "description": "Plain text fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "options": {
        "only": [
          "dotfiles/common/plain.txt.linked/x"
        ]
      }
    }
  ]
}
