{
  "description": "A push whose input ends at the PR question takes the default No, sends nothing and restores the repo folder, exit 0 (Front door, push).",
  "os": ["linux"],
  "git": "remote",
  "syncPoint": true,
  "stubs": ["gh"],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "First parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "push"
    }
  ]
}
