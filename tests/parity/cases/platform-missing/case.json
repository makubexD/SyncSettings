{
  "description": "Export stops before touching a file when an entry has no platform (Entry selection).",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/parity/ok.conf",
        "localPath": "~/.config/parity/ok.conf",
        "platform": "common",
        "description": "Parity case file"
      },
      {
        "repoPath": "dotfiles/common/parity/bad.conf",
        "localPath": "~/.config/parity/bad.conf",
        "description": "Parity case entry without a platform"
      }
    ]
  },
  "commands": [{ "command": "export" }]
}
