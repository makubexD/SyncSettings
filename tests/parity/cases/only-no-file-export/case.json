{
  "description": "Export with --only matching no file warns, leaves the repo unchanged and exits 0 (Picking files). Ported from only-no-file-export, Pester only-no-file-export.",
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/linux/plain.txt",
        "localPath": "~/.config/fixture/plain.txt",
        "platform": "linux",
        "description": "Plain text fixture"
      },
      {
        "repoPath": "dotfiles/common/dir",
        "localPath": "~/.config/fixture/dir",
        "type": "dir",
        "platform": "common",
        "description": "Directory fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "options": {
        "only": ["~/.config/fixture/dir/missing.txt"]
      }
    }
  ]
}
