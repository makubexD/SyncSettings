{
  "description": "export --preview shows a changed value as the sanitized text the layer will hold: the placeholder <YOUR_EMAIL>, never the profile's value (Push preview (program only), Values are the sanitized text).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings",
        "sanitize": [
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email for git commits"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "git": "committed",
  "commands": [
    {
      "command": "preview",
      "output": "all"
    }
  ]
}
