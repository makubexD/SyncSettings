{
  "description": "setup asks the values before the summary; n at the confirm stops with nothing written: no record, no profile, no saved values, no file (mksync setup, Values before the summary, Confirm).",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name",
            "suggest": [
              "git-user-name"
            ]
          },
          {
            "placeholder": "<YOUR_EMAIL>",
            "prompt": "Email"
          }
        ]
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "setup",
      "stdin": "work-1\n\n2\n1\n1\n\njane@example.com\nn\n"
    },
    {
      "command": "machine-show",
      "stderr": true
    }
  ]
}
