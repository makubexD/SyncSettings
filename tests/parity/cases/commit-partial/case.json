{
  "description": "A partial commit opens the PR and leaves the recorded sync point as it was, exit 0 (Sync point).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "commands": [
    {
      "command": "export"
    },
    {
      "command": "commit",
      "options": {
        "partial": true
      }
    }
  ]
}
