{
  "description": "Push exports this machine's change and, with --yes, commits it and opens a PR, exit 0 (Front door, push row).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "push",
      "options": {
        "yes": true
      }
    }
  ]
}
