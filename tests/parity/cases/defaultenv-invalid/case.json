{
  "description": "An invalid defaultEnv name stops export with exit 1 before it touches a file, on every OS (Path safety, Known differences).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/git.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/git.conf",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name",
            "defaultEnv": "1BAD"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<YOUR_NAME>": "Parity User"
  },
  "commands": [
    {
      "command": "export"
    }
  ],
  "differences": [
    "defaultEnv name check"
  ]
}
