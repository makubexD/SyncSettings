{
  "description": "Export reports no ORPHAN for a file under the .linked/ folder of a detectLinkedPaths entry, which owns it (Orphan report; Linked folders).",
  "os": [
    "linux",
    "macos"
  ],
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "linked.sh",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/linked.sh",
        "os": [
          "windows"
        ],
        "scanLinks": true,
        "description": "Windows linked fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
