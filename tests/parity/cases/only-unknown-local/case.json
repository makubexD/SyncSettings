{
  "description": "Import refuses a --only local path no entry owns, exit 1, before touching any file (Picking files). Ported from import-only-unknown, Pester only-unknown.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "plain.txt",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/plain.txt",
        "os": [
          "linux"
        ],
        "description": "Plain text fixture"
      },
      {
        "file": "dir",
        "module": "unsorted",
        "merge": "dir",
        "localPath": "~/.config/fixture/dir",
        "description": "Directory fixture"
      }
    ]
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true,
        "only": [
          "~/not-synced"
        ]
      }
    }
  ]
}
