{
  "description": "setup --replace reads past a bad local record and goes on as if this machine had none, so the missing record gives the contract's no-machine error and exit 1 instead of the record error (Machines (program only), replace).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity file"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-new",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git"
  },
  "commands": [
    {
      "command": "setup",
      "options": {
        "replace": "wk1-laptop"
      },
      "stderr": true
    }
  ]
}
