{
  "description": "Push with a sync point, without a terminal and with no alias in the record stops after the export with the contract's error, exit 1, before any commit or gh call, and writes nothing (The PR; plan-windows-hotfix decisions 1 and 3, the alias is asked once on the first push from a terminal).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig",
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "push",
      "options": {
        "yes": true
      },
      "stderr": true
    }
  ],
  "syncPoint": true
}
