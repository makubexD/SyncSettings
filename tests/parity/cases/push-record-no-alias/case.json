{
  "description": "commit without a terminal and with no alias in the record stops with the contract's error, exit 1, before any branch, commit or gh call, and writes nothing (The PR: a record without a public name asks on a terminal; push --yes takes the suggestion, so the bare commit is what has no one to ask).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig",
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "MKSYNC_VISIBILITY": "public"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "options": {
        "yes": true
      }
    },
    {
      "command": "commit",
      "stderr": true
    }
  ],
  "syncPoint": true
}
