{
  "description": "Export in a terminal asks for a value nothing fills (no saved value, no line to infer from, no default), with import's header and prompt, sanitizes with the answer and saves it to .user-values.json (Sanitize and hydrate, Push asks).",
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Sanitized parity file",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "export",
      "stdin": "Ana Lopez\n"
    }
  ]
}
