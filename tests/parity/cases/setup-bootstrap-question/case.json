{
  "description": "On Ubuntu with an executable bootstrap/linux.sh, setup asks the bootstrap question before the summary, with --bootstrap in Same as:; --yes answers the confirm, y runs the script with MKSYNC_SETUP_EXISTING=backup, so the script imports as answer 4 says and setup imports nothing after it, exit 0 (mksync setup, Bootstrap, Then).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude",
    "SYNC_OS_RELEASE": "../home/os-release"
  },
  "stubs": ["bootstrap", "gh"],
  "commands": [
    {
      "command": "setup",
      "options": {
        "profile": "work-1",
        "yes": true
      },
      "stdin": "y\n"
    }
  ]
}
