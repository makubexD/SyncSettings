{
  "description": "On Ubuntu with an executable bootstrap/linux.sh, the v2 setup writes the record and the profile, then asks the bootstrap question; y runs the script and setup ends with its exit code, with no first pull (Machines (program only), mksync setup, bootstrap).",
  "os": ["linux"],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude",
    "SYNC_OS_RELEASE": "../home/os-release"
  },
  "stubs": ["bootstrap", "gh"],
  "commands": [
    {
      "command": "setup",
      "options": {
        "profile": "work-1",
        "yes": true
      },
      "stdin": "y\n"
    }
  ]
}
