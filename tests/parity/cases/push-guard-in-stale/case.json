{
  "description": "Push stops with exit 1, and calls no gh, when a file it would leave alone (IN) has an older version already in the repo folder from an earlier export: the commit would send it (Front door, push).",
  "os": [
    "linux"
  ],
  "git": "remote",
  "syncPoint": true,
  "env": {
    "GIT_CONFIG_GLOBAL": "../home/gitconfig"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "First parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Second parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "pull",
      "options": {
        "paths": [
          "dotfiles/common/parity/a.conf"
        ],
        "yes": true
      }
    },
    {
      "command": "export",
      "options": {
        "yes": true
      }
    },
    {
      "command": "push",
      "options": {
        "yes": true
      },
      "stderr": true
    }
  ],
  "stubs": [
    "gh"
  ]
}
