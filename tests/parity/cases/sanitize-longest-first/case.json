{
  "description": "Export replaces the longest value first, so a value holding a shorter one becomes one placeholder (Sanitize and hydrate).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<A>",
            "prompt": "Short value"
          },
          {
            "placeholder": "<B>",
            "prompt": "Long value"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<A>": "ab",
    "<B>": "abc"
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
