{
  "description": "setup --label with a profile that already exists stops with exit 2 before any question and changes nothing (Machines (program only), mksync setup, Label).",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "shell": {
        "description": "Shell start-up files"
      },
      "git": {
        "description": "Git settings"
      }
    },
    "entries": [
      {
        "file": "shell/bashrc",
        "module": "shell",
        "merge": "whole",
        "localPath": "~/.config/parity/bashrc",
        "description": "Shell start-up file"
      },
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "stubs": [
    "gh"
  ],
  "commands": [
    {
      "command": "setup",
      "options": {
        "name": "wk1-laptop",
        "profile": "work1",
        "label": "acme",
        "claude": "claude",
        "mode": "push",
        "existing": "stop"
      },
      "stdin": "y\n",
      "stderr": true
    }
  ]
}
