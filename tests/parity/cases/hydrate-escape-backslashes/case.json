{
  "description": "Import fills a placeholder whose rule escapes backslashes with the doubled value: CREATED (Sanitize and hydrate).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<DIR>",
            "prompt": "Tools directory",
            "escapeBackslashes": true
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "values": {
    "<DIR>": "C:\\Tools"
  },
  "commands": [
    {
      "command": "import",
      "options": {
        "force": true
      }
    }
  ]
}
