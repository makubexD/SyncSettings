{
  "description": "The import check refuses --reset-values before touching anything: the contract's ERROR line, exit 2, no file changed (Import check). Exit 2 since phase 9 decision 7.",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "sanitize": [
          {
            "placeholder": "<YOUR_NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Sanitized parity file"
      }
    ]
  },
  "commands": [
    {
      "command": "check",
      "options": {
        "resetValues": true
      },
      "stderr": true
    }
  ]
}
