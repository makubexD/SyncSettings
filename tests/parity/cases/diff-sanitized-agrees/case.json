{
  "description": "Diff with a recorded sync point treats a local sanitized file holding the hydrated value as agreeing with the repo, exit 0 (Diff, Sync point). Ported from diff-sanitized.",
  "git": "remote",
  "syncPoint": true,
  "config": {
    "version": 1,
    "excludePatterns": ["*.bak"],
    "files": [
      {
        "repoPath": "dotfiles/common/named.conf",
        "localPath": "~/.config/fixture/named.conf",
        "platform": "common",
        "description": "Sanitized fixture",
        "sanitizeRules": [
          { "placeholder": "<NAME>", "prompt": "Full name" }
        ]
      }
    ]
  },
  "values": { "<NAME>": "Someone" },
  "commands": [{ "command": "diff" }]
}
