{
  "description": "Diff with a recorded sync point treats a local sanitized file holding the hydrated value as agreeing with the repo, exit 0 (Diff, Sync point). Ported from diff-sanitized.",
  "git": "remote",
  "syncPoint": true,
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "named.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/fixture/named.conf",
        "sanitize": [
          {
            "placeholder": "<NAME>",
            "prompt": "Full name"
          }
        ],
        "description": "Sanitized fixture"
      }
    ]
  },
  "values": {
    "<NAME>": "Someone"
  },
  "commands": [
    {
      "command": "diff"
    }
  ]
}
