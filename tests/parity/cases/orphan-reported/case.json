{
  "description": "Export lists a repo file no entry owns and keeps it: ORPHAN (Orphan report).",
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "unsorted": {
        "description": "Entries converted from v1, not sorted yet."
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "unsorted",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    }
  ]
}
