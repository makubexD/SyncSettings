{
  "description": "Diff with a stored profile override this machine never applied agrees, exit 0: the local file is what git's layers build (Diff, private layers).",
  "os": ["linux"],
  "git": "remote",
  "syncPoint": true,
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": ["*.bak"],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/settings.json",
        "module": "parity",
        "merge": "json",
        "localPath": "~/.config/parity/settings.json",
        "description": "Parity JSON settings"
      }
    ]
  },
  "commands": [
    {
      "command": "diff"
    }
  ]
}
