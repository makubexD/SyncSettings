{
  "description": "profile show prints a profile's name, label, modules, value keys (never the values) and layer files (a dir entry's as <file>/<name inside>), this machine's profile by default; a retired profile adds retired yes; a missing profile is exit 1, a second positional exit 2; nothing is written (Machines (program only), mksync profile show).",
  "os": [
    "linux"
  ],
  "configV2": {
    "schemaVersion": 2,
    "modules": {
      "git": {
        "description": "Git settings"
      },
      "vscode": {
        "description": "VS Code settings"
      }
    },
    "entries": [
      {
        "file": "git/gitconfig",
        "module": "git",
        "merge": "whole",
        "localPath": "~/.config/parity/gitconfig",
        "description": "Git global config"
      },
      {
        "file": "vscode/settings.json",
        "module": "vscode",
        "merge": "whole",
        "localPath": "~/.config/parity/settings.json",
        "description": "VS Code user settings"
      },
      {
        "file": "vscode/snippets",
        "module": "vscode",
        "merge": "dir",
        "localPath": "~/.config/parity/snippets",
        "description": "VS Code snippets"
      }
    ]
  },
  "env": {
    "SYNC_HOSTNAME": "wk1-laptop",
    "SYNC_DOMAIN": "",
    "SYNC_TOOLS": "git,gh,claude"
  },
  "commands": [
    {
      "command": "args",
      "argv": [
        "profile",
        "show"
      ],
      "stderr": true
    },
    {
      "command": "args",
      "argv": [
        "profile",
        "show",
        "work2"
      ],
      "stderr": true
    },
    {
      "command": "args",
      "argv": [
        "profile",
        "show",
        "work9"
      ],
      "stderr": true
    },
    {
      "command": "args",
      "argv": [
        "profile",
        "show",
        "work1",
        "x"
      ],
      "stderr": true
    }
  ]
}
