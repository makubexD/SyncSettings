{
  "description": "A cached value of one entry's rule appears in another entry's file that has no rule: commit stops with the cached-value line and the hint, exit 1, and never calls gh (Checks before pushing, Cached values).",
  "git": "remote",
  "stubs": [
    "gh"
  ],
  "values": {
    "<YOUR_GH_ORG>": "parity-org"
  },
  "configV2": {
    "schemaVersion": 2,
    "excludePatterns": [
      "*.bak"
    ],
    "modules": {
      "parity": {
        "description": "Parity case files"
      }
    },
    "entries": [
      {
        "file": "parity/a.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/a.conf",
        "description": "Parity case file"
      },
      {
        "file": "parity/b.conf",
        "module": "parity",
        "merge": "whole",
        "localPath": "~/.config/parity/b.conf",
        "description": "Sanitized parity file, no local copy",
        "sanitize": [
          {
            "placeholder": "<YOUR_GH_ORG>",
            "prompt": "GitHub organization"
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "command": "export"
    },
    {
      "command": "commit",
      "output": "all",
      "stderr": true
    }
  ]
}
