#!/usr/bin/env bash
# One command for the sync flow: status, doctor, preview, export, commit, import.
set -euo pipefail

# Resolve the script through a symlink (mksync on PATH) before changing the
# working directory, so every relative path below is the repo's.
cd "$(dirname "$(readlink -f "$0")")"
REPO_ROOT=$PWD

usage() {
    printf 'usage: mksync [command] [options]\n'
    printf '  (none)   show where this machine stands and what to run next\n'
    printf '  doctor   check the tools and the setup\n'
    printf '  setup    first run on this machine\n'
    printf '  pull     get the latest repo and apply it here\n'
    printf "  push     send this machine's changes as a PR\n"
    printf '  preview | export | commit | import   the single steps\n'
}

# Windows shells hand over to the batch wrapper; cmd.exe needs // so it does not
# read the switch as a path.
case $(uname -s 2>/dev/null || printf 'Linux') in
    MINGW*|MSYS*|CYGWIN*)
        exec cmd.exe //c sync.cmd "$@"
        ;;
esac

if (( $# == 0 )); then
    source "$REPO_ROOT/scripts/linux/front.sh"
    front_status
    exit 0
fi

COMMAND=$1
shift

case $COMMAND in
    help|-h)
        usage
        printf '  Detected: linux\n'
        exit 0
        ;;
    status)
        source "$REPO_ROOT/scripts/linux/front.sh"
        front_status
        exit 0
        ;;
    doctor)
        # No require_tool before this: doctor must run with tools missing.
        source "$REPO_ROOT/scripts/linux/front.sh"
        if front_doctor; then
            exit 0
        fi
        exit 1
        ;;
    setup)
        # Runs before require_tool, like doctor: setup reports missing tools
        # itself and needs no gh.
        source "$REPO_ROOT/scripts/linux/front.sh"
        front_setup "$@"
        exit 0
        ;;
    preview|export|import|commit|pull|push) ;;
    *)
        printf 'Unknown command: %s\n' "$COMMAND" >&2
        usage >&2
        exit 1
        ;;
esac

require_tool() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'ERROR: %s is not installed. Install it and run the command again.\n' "$1" >&2
        exit 1
    fi
}

require_tool git
require_tool jq
if [[ $COMMAND == commit || $COMMAND == push ]]; then
    require_tool gh
fi

case $COMMAND in
    preview) exec ./export.sh --preview "$@" ;;
    export) exec ./export.sh "$@" ;;
    import) exec ./import.sh "$@" ;;
    commit) exec ./commit.sh "$@" ;;
    pull)
        source "$REPO_ROOT/scripts/linux/front.sh"
        front_pull "$@"
        ;;
    push)
        source "$REPO_ROOT/scripts/linux/front.sh"
        front_push "$@"
        ;;
esac
