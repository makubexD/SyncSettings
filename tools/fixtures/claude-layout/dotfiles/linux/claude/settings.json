{
  "cleanupPeriodDays": 36500,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Read",
      "WebFetch(example.com/*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/worker-mode-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/node.sh <HOME>/.claude/hooks/context-mode-cache-heal.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/metrics-capture.sh SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/metrics-capture.sh UserPromptSubmit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/context-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/metrics-capture.sh PostToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/context-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/metrics-capture.sh SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "<HOME>/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "example-plugin@example-marketplace": true
  },
  "extraKnownMarketplaces": {
    "example-marketplace": {
      "source": {
        "source": "url",
        "url": "https://example.com/marketplace.json"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "**Host**: example.com test host with open internet.",
      "**Source control**: repos under example.com are trusted."
    ]
  },
  "model": "opus"
}
