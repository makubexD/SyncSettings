      "path": "/org/gnome/settings-daemon/plugins/power/",
      "type": "dconf",
      "platform": "linux",
      "description": "Dimming and sleep on AC"
    },
    {
      "repoPath": "dotfiles/linux/gnome/dconf/shell.ini",
      "path": "/org/gnome/shell/",
      "type": "dconf",
      "platform": "linux",
      "description": "Dock favorites, extensions, shell shortcuts",
      "keys": ["favorite-apps", "enabled-extensions", "disabled-extensions", "keybindings/*"]
    },
    {
      "repoPath": "dotfiles/linux/gnome/dconf/ptyxis.ini",
      "path": "/org/gnome/Ptyxis/",
      "type": "dconf",
      "platform": "linux",
      "description": "Ptyxis preferences and profiles, without window size",
      "keys": [
        "audible-bell", "cursor-blink-mode", "cursor-shape", "default-columns", "default-profile-uuid", "default-rows",
        "disable-padding", "enable-a11y", "enable-zoom-scroll-ctrl", "font-name", "ignore-osc-title", "inhibit-logout",
        "interface-style", "new-tab-position", "profile-uuids", "prompt-on-close", "restore-session", "restore-window-size",
        "scrollbar-policy", "tab-middle-click", "text-blink-mode", "toast-on-copy-clipboard", "use-system-font", "visual-bell",
        "visual-process-leader", "word-char-exceptions", "Profiles/*"
      ]
    },
    {
      "repoPath": "dotfiles/linux/gnome/dconf/nautilus.ini",
      "path": "/org/gnome/nautilus/preferences/",
      "type": "dconf",
      "platform": "linux",
      "description": "Files default view"
    },
    {
      "repoPath": "dotfiles/linux/gnome/dconf/file-chooser.ini",
      "path": "/org/gtk/gtk4/settings/file-chooser/",
      "type": "dconf",
      "platform": "linux",
      "description": "File dialog: hidden files, folders first",
      "keys": ["show-*", "sort-directories-first"]
    }
