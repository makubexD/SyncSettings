{
  "version": 1,
  "defaultUser": null,
  "files": [
    {
      "repoPath": "dotfiles/common/git/.gitconfig",
      "localPath": "~/.gitconfig",
      "platform": "common",
      "description": "Git global configuration",
      "sanitizeRules": [
        {
          "placeholder": "<YOUR_NAME>",
          "prompt": "Full name for git commits"
        },
        {
          "placeholder": "<YOUR_EMAIL>",
          "prompt": "Email for git commits"
        }
      ]
    },
    {
      "repoPath": "dotfiles/windows/git/.gitconfig.local",
      "localPath": "~\\.gitconfig.local",
      "platform": "windows",
      "description": "Git credentials for Windows, included by .gitconfig",
      "sanitizeRules": [
        {
          "placeholder": "<YOUR_GH_USERNAME>",
          "prompt": "GitHub username"
        },
        {
          "placeholder": "<YOUR_GH_ORG>",
          "prompt": "GitHub organization (e.g., MAKUSOFT)"
        },
        {
          "placeholder": "<GH_CLI_PATH>",
          "prompt": "Path to GitHub CLI executable",
          "default": "C:\\Program Files\\GitHub CLI\\gh.exe",
          "escapeBackslashes": true
        }
      ]
    },
    {
      "repoPath": "dotfiles/linux/git/.gitconfig.local",
      "localPath": "~/.gitconfig.local",
      "platform": "linux",
      "description": "Git credentials for Linux, included by .gitconfig"
    },
    {
      "repoPath": "dotfiles/windows/shell/.bashrc",
      "localPath": "~\\.bashrc",
      "platform": "windows",
      "description": "Bash run commands",
      "detectLinkedPaths": true
    },
    {
      "repoPath": "dotfiles/windows/shell/.bash_profile",
      "localPath": "~\\.bash_profile",
      "platform": "windows",
      "description": "Bash login profile"
    },
    {
      "repoPath": "dotfiles/windows/windows-terminal/settings.json",
      "localPath": "~\\AppData\\Local\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState\\settings.json",
      "platform": "windows",
      "description": "Windows Terminal settings"
    },
    {
      "repoPath": "dotfiles/linux/claude/CLAUDE.md",
      "localPath": "~/.claude/CLAUDE.md",
      "platform": "linux",
      "description": "Claude Code global instructions"
    },
    {
      "repoPath": "dotfiles/common/claude/RTK.md",
      "localPath": "~/.claude/RTK.md",
      "platform": "common",
      "description": "RTK command-output notes (imported by CLAUDE.md)"
    },
    {
      "repoPath": "dotfiles/linux/claude/settings.json",
      "localPath": "~/.claude/settings.json",
      "platform": "linux",
      "description": "Claude Code user settings (hooks, plugins, permissions)",
      "sanitizeRules": [
        {
          "placeholder": "<HOME>",
          "prompt": "Home directory",
          "defaultEnv": "HOME"
        },
        {
          "placeholder": "<YOUR_GH_USERNAME>",
          "prompt": "GitHub username"
        }
      ]
    },
    {
      "repoPath": "dotfiles/linux/claude/statusline.sh",
      "localPath": "~/.claude/statusline.sh",
      "platform": "linux",
      "description": "Claude Code status line script"
    },
    {
      "repoPath": "dotfiles/linux/claude/sampleGrok.md",
      "localPath": "~/.claude/sampleGrok.md",
      "platform": "linux",
      "description": "Old Windows CLAUDE.md for the Grok setup (reference)"
    },
    {
      "repoPath": "dotfiles/linux/claude/hooks/context-mode-cache-heal.mjs",
      "localPath": "~/.claude/hooks/context-mode-cache-heal.mjs",
      "platform": "linux",
      "description": "context-mode SessionStart hook"
    },
    {
      "repoPath": "dotfiles/linux/claude/hooks/node.sh",
      "localPath": "~/.claude/hooks/node.sh",
      "platform": "linux",
      "description": "Runs hook scripts with the nvm Node"
    },
    {
      "repoPath": "dotfiles/linux/claude/hooks/worker-mode-guard.sh",
      "localPath": "~/.claude/hooks/worker-mode-guard.sh",
      "platform": "linux",
      "description": "Blocks Claude edits while worker mode is on"
    },
    {
      "repoPath": "dotfiles/linux/claude/skills/mk-delegate/SKILL.md",
      "localPath": "~/.claude/skills/mk-delegate/SKILL.md",
      "platform": "linux",
      "description": "/mk-delegate slash command"
    },
    {
      "repoPath": "dotfiles/linux/claude/skills/mk-check/SKILL.md",
      "localPath": "~/.claude/skills/mk-check/SKILL.md",
      "platform": "linux",
      "description": "/mk-check slash command"
    },
    {
      "repoPath": "dotfiles/common/claude/docs/token-routing-map.html",
      "localPath": "~/.claude/docs/token-routing-map.html",
      "platform": "common",
      "description": "Workflow guide page source"
    },
    {
      "repoPath": "dotfiles/linux/claude/bin/mk-exec",
      "localPath": "~/.claude/bin/mk-exec",
      "platform": "linux",
      "description": "Worker wrapper: runs a task as headless Claude Code on the paid DeepSeek API, with logs"
    },
    {
      "repoPath": "dotfiles/linux/claude/bin/workflow-report",
      "localPath": "~/.claude/bin/workflow-report",
      "platform": "linux",
      "description": "Read-only report of delegated vs inline steps and worker runs for a repo"
    },
    {
      "repoPath": "dotfiles/linux/claude-worker/CLAUDE.md",
      "localPath": "~/.claude-worker/CLAUDE.md",
      "platform": "linux",
      "description": "Worker rules for the mk-exec Claude Code process (its own config dir)"
    },
    {
      "repoPath": "dotfiles/linux/claude-worker/settings.json",
      "localPath": "~/.claude-worker/settings.json",
      "platform": "linux",
      "description": "Worker permissions for the mk-exec Claude Code process"
    },
    {
      "repoPath": "dotfiles/linux/claude/bin/worker-mode",
      "localPath": "~/.claude/bin/worker-mode",
      "platform": "linux",
      "description": "worker-mode on|off|status switch"
    },
    {
      "repoPath": "dotfiles/linux/claude/plugins/installed_plugins.json",
      "localPath": "~/.claude/plugins/installed_plugins.json",
      "platform": "linux",
      "description": "Installed Claude Code plugins",
      "sanitizeRules": [
        {
          "placeholder": "<HOME>",
          "prompt": "Home directory",
          "defaultEnv": "HOME"
        }
      ]
    },
    {
      "repoPath": "dotfiles/linux/claude/plugins/known_marketplaces.json",
      "localPath": "~/.claude/plugins/known_marketplaces.json",
      "platform": "linux",
      "description": "Known plugin marketplaces",
      "sanitizeRules": [
        {
          "placeholder": "<HOME>",
          "prompt": "Home directory",
          "defaultEnv": "HOME"
        }
      ]
    }
  ],
  "excludePatterns": [
    "*.pem",
    "*.key",
    "*.pfx",
    "*.p12",
    "*.bak",
    "id_rsa*",
    "id_ed25519*",
    "id_ecdsa*",
    "*.credential*",
    "credentials",
    "credentials.json",
    ".env",
    ".env.*",
    "*.secret*",
    "*.token*",
    ".git-credentials",
    ".netrc",
    ".npmrc",
    ".pgpass",
    "hosts.yml",
    "auth.json",
    "secrets.yaml",
    "token",
    "*.env",
    "id_dsa*"
  ]
}
