# ===== CREDENTIALS =====
# Note: the empty "helper =" before the gh.exe line resets the default
# credential helper so only gh.exe is used for that host (precedence reset).
[credential]
	helper = manager
	username = <YOUR_GH_USERNAME>
[credential "https://github.com"]
	username = <YOUR_GH_USERNAME>
	helper = 
	helper = !'<GH_CLI_PATH>' auth git-credential
[credential "https://github.com/<YOUR_GH_ORG>"]
	username = <YOUR_GH_USERNAME>
[credential "https://gist.github.com"]
	helper = 
	helper = !'<GH_CLI_PATH>' auth git-credential
